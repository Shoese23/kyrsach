<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#121212"
    tools:context=".EntryActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#121212">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#121212"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:title="Запись настроения"
            app:titleTextColor="#E0E0E0"
            android:layout_marginBottom="8dp"
            app:navigationIconTint="#FFFFFF"
            />

        <TextView
            android:id="@+id/tv_entry_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="14 сентября 2026"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#E0E0E0"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Как вы себя чувствуете?"
            android:textSize="16sp"
            android:textColor="#E0E0E0"
            android:layout_marginBottom="8dp"/>

        <RadioGroup
            android:id="@+id/rg_emoji"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <RadioButton
                android:id="@+id/rb_emoji_bad"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:button="@null"
                android:gravity="center"
                android:text="😞"
                android:textSize="32sp"
                android:padding="8dp"/>

            <RadioButton
                android:id="@+id/rb_emoji_neutral"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:button="@null"
                android:gravity="center"
                android:text="😐"
                android:textSize="32sp"
                android:padding="8dp"/>

            <RadioButton
                android:id="@+id/rb_emoji_good"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:button="@null"
                android:gravity="center"
                android:text="😊"
                android:textSize="32sp"
                android:padding="8dp"/>
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Цвет настроения"
            android:textSize="16sp"
            android:textColor="#E0E0E0"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:id="@+id/ll_color_selector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <View
                android:id="@+id/color_bad"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_margin="8dp"
                android:background="#FF5252"
                android:alpha="0.5"/>

            <View
                android:id="@+id/color_neutral"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_margin="8dp"
                android:background="#FFEB3B"
                android:alpha="0.5"/>

            <View
                android:id="@+id/color_good"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_margin="8dp"
                android:background="#4CAF50"
                android:alpha="0.5"/>
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:hint="Опишите свой день"
            app:boxStrokeColor="#91BFC2"
            app:hintTextColor="#91BFC2">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_mood_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="4"
                android:maxLines="8"
                android:textColor="#E0E0E0"
                android:textColorHint="#9E9E9E"
                android:hint="Опишите свой день"/>
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="0dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_delete"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Удалить"
                android:textColor="#F44336"
                app:strokeColor="#F44336"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Сохранить"
                app:backgroundTint="#91BFC2"
                app:rippleColor="#5A8F92"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>